{% extends 'base_public.html.twig' %}

{% block title %}À propos — ServiceLab Canada{% endblock %}
{% block meta_description %}Découvrez ServiceLab Canada : location d'équipements de cuisine professionnelle, partenariat TZANET, maintenance et accompagnement.{% endblock %}

{% block body %}
<section class="hero hero--compact hero--visual" data-controller="reveal">
    <div class="hero__media" aria-hidden="true">
        <img src="{{ asset('images/restaurant-interior.png') }}" alt="" loading="eager">
        <div class="hero__media-overlay"></div>
    </div>
    <div class="hero__inner hero__inner--center">
        <div data-reveal>
            <span class="pill pill--primary">À propos</span>
            <h1 class="hero__title">La location pro,<br><span>sans friction.</span></h1>
            <p class="hero__lead">ServiceLab équipe les cuisines commerciales avec des machines, des produits et une maintenance claire — en partenariat avec TZANET.</p>
        </div>
    </div>
</section>

<section class="section" data-controller="reveal">
    <div class="section__inner about-grid">
        <div data-reveal="left">
            <p class="eyebrow">Notre mission</p>
            <h2>Transformer un besoin d’équipement en solution simple</h2>
            <p>Quand un client ne peut pas acheter immédiatement, TZANET l’oriente vers ServiceLab. Nous gérons la location, le suivi et la relation commerciale — avec une traçabilité complète de la source.</p>
            <div class="about-stats" data-controller="counters">
                <div class="about-stat">
                    <strong data-counters-target="value" data-to="48">0</strong>
                    <span>h de réponse moyenne</span>
                </div>
                <div class="about-stat">
                    <strong data-counters-target="value" data-to="100" data-suffix="%">0%</strong>
                    <span>leads tracés</span>
                </div>
                <div class="about-stat">
                    <strong>1er</strong>
                    <span>mois offert TZANET</span>
                </div>
            </div>
        </div>
        <div class="about-media" data-reveal="scale" data-reveal-delay="100">
            <img src="{{ asset('images/hero-kitchen.png') }}" alt="Cuisine commerciale ServiceLab" loading="lazy">
        </div>
    </div>
</section>

<section class="section section--features" data-controller="reveal">
    <div class="section__inner">
        <div class="section__intro section__intro--center" data-reveal>
            <p class="eyebrow">Ce qui nous différencie</p>
            <h2>Un portail pensé comme un produit SaaS</h2>
            <p>Des outils clairs pour suivre les leads, sécuriser les commissions et accélérer le parcours client.</p>
        </div>

        <div class="feature-grid">
            <article class="feature-card feature-card--primary" data-reveal data-reveal-delay="40">
                <div class="feature-card__top">
                    <span class="feature-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8 11h6M11 8v6"/>
                        </svg>
                    </span>
                    <span class="feature-card__tag">Core</span>
                </div>
                <h3>Traçabilité TZANET</h3>
                <p>Chaque demande est taguée automatiquement. Plus de confusion sur l’origine du client ni sur les commissions.</p>
                <ul class="feature-card__list">
                    <li>Source détectée via QR</li>
                    <li>Historique commercial clair</li>
                </ul>
            </article>

            <article class="feature-card" data-reveal data-reveal-delay="90">
                <div class="feature-card__top">
                    <span class="feature-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2v20"/><path d="M17 6H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"/>
                        </svg>
                    </span>
                    <span class="feature-card__tag">Finance</span>
                </div>
                <h3>Commissions claires</h3>
                <p>Règles configurables à la signature et retour annuel — calculées sans tableur.</p>
                <ul class="feature-card__list">
                    <li>Montant à la signature</li>
                    <li>Statuts À payer / Payée</li>
                </ul>
            </article>

            <article class="feature-card" data-reveal data-reveal-delay="140">
                <div class="feature-card__top">
                    <span class="feature-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>
                        </svg>
                    </span>
                    <span class="feature-card__tag">Mobile</span>
                </div>
                <h3>Parcours mobile</h3>
                <p>QR en magasin → formulaire → suivi ServiceLab. Pensé pour le smartphone client.</p>
                <ul class="feature-card__list">
                    <li>Formulaire court</li>
                    <li>Expérience fluide</li>
                </ul>
            </article>

            <article class="feature-card feature-card--accent" data-reveal data-reveal-delay="190">
                <div class="feature-card__glow" aria-hidden="true"></div>
                <div class="feature-card__top">
                    <span class="feature-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"/><path d="M12 12 4 7.5M12 12l8-4.5M12 12v9"/>
                        </svg>
                    </span>
                    <span class="feature-card__tag">Scale</span>
                </div>
                <h3>Partenariat évolutif</h3>
                <p>Architecture prête pour d’autres partenaires commerciaux, sans reconstruire le produit.</p>
                <ul class="feature-card__list">
                    <li>Base multi-partenaires ready</li>
                    <li>Offres configurables</li>
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="section section--process" data-controller="reveal">
    <div class="section__inner">
        <div class="section__intro section__intro--center" data-reveal>
            <p class="eyebrow">Comment on travaille</p>
            <h2>Du magasin TZANET au contrat actif</h2>
            <p>Un parcours simple, tracé de bout en bout — du premier scan jusqu’au suivi opérationnel.</p>
        </div>

        <ol class="process-steps">
            <li class="process-step" data-reveal data-reveal-delay="40">
                <div class="process-step__head">
                    <span class="process-step__num">01</span>
                    <span class="process-step__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 10h8M8 14h5"/>
                        </svg>
                    </span>
                </div>
                <h3>Orientation</h3>
                <p>Le client découvre l’offre via QR en magasin TZANET et dépose sa demande sur la page partenaire.</p>
            </li>
            <li class="process-step" data-reveal data-reveal-delay="90">
                <div class="process-step__head">
                    <span class="process-step__num">02</span>
                    <span class="process-step__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/><path d="M8.5 11h5"/>
                        </svg>
                    </span>
                </div>
                <h3>Qualification</h3>
                <p>ServiceLab analyse le besoin et propose la machine adaptée à la cuisine.</p>
            </li>
            <li class="process-step" data-reveal data-reveal-delay="140">
                <div class="process-step__head">
                    <span class="process-step__num">03</span>
                    <span class="process-step__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 12.5 10.5 15 16 9"/><rect x="3" y="3" width="18" height="18" rx="4"/>
                        </svg>
                    </span>
                </div>
                <h3>Signature</h3>
                <p>Contrat créé dans le portail. Commission calculée automatiquement si source TZANET.</p>
            </li>
            <li class="process-step" data-reveal data-reveal-delay="190">
                <div class="process-step__head">
                    <span class="process-step__num">04</span>
                    <span class="process-step__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v4"/><path d="M12 17v4"/><circle cx="12" cy="12" r="3"/><path d="m5 5 2.5 2.5M16.5 16.5 19 19M5 19l2.5-2.5M16.5 7.5 19 5"/>
                        </svg>
                    </span>
                </div>
                <h3>Exploitation</h3>
                <p>Maintenance, produits et suivi commercial — la cuisine reste opérationnelle.</p>
            </li>
        </ol>
    </div>
</section>

<section class="section section--cta-band" data-controller="reveal">
    <div class="section__inner">
        <div class="cta-panel" data-reveal="scale">
            <div class="cta-panel__glow" aria-hidden="true"></div>
            <div class="cta-panel__content">
                <p class="eyebrow eyebrow--on-dark">Passez à l’action</p>
                <h2>Prêt à équiper votre cuisine ?</h2>
                <p>Parlez à l’équipe ServiceLab ou profitez de l’offre partenaire TZANET.</p>
            </div>
            <div class="cta-panel__actions">
                <a href="{{ path('app_contact') }}" class="btn btn-primary btn-lg">Nous contacter</a>
                <a href="{{ path('partner_tzanet') }}" class="btn btn-secondary btn-lg">Offre TZANET</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
