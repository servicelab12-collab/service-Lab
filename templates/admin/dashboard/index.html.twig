{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — ServiceLab Partner Portal{% endblock %}
{% block page_heading %}Dashboard{% endblock %}

{% block content %}
<section class="admin-hero" data-controller="reveal">
    <div class="admin-hero__copy" data-reveal>
        <p class="eyebrow eyebrow--on-dark">Espace ServiceLab</p>
        <h1>Bonjour {{ app.user.nom|split(' ')|first }}</h1>
        <p>Chaque demande TZANET du site client arrive ici en temps réel — pipeline, contrats et commissions liés.</p>
        <div class="admin-hero__actions">
            <a href="{{ path('partner_tzanet') }}" class="btn btn-primary btn-sm">Offre TZANET</a>
            <a href="{{ path('qr_tzanet_page') }}" class="btn btn-secondary btn-sm" target="_blank" rel="noopener">QR Code TZANET</a>
            <a href="{{ path('admin_leads') }}" class="btn btn-secondary btn-sm">Voir les leads</a>
            <a href="{{ path('admin_leads_pdf_all') }}" data-turbo="false" class="btn btn-secondary btn-sm">PDF tous les leads</a>
        </div>
    </div>
    <div class="admin-hero__media" data-reveal="scale" data-reveal-delay="100">
        <img src="{{ asset('images/hero-kitchen.png') }}" alt="" loading="lazy">
        <div class="admin-hero__chip">
            <span class="admin-hero__dot"></span>
            Sync site client ↔ admin
        </div>
    </div>
</section>

<section class="admin-bridge" data-controller="reveal">
    <div class="admin-bridge__head" data-reveal>
        <div>
            <p class="eyebrow">Flux live</p>
            <h2>Site client → Portail</h2>
            <p>Les demandes de l’offre TZANET alimentent ce dashboard.</p>
        </div>
        {% if activeOffer %}
            <div class="admin-bridge__offer" data-reveal data-reveal-delay="80">
                <strong>Offre active partagée</strong>
                <span>
                    {% if activeOffer.commissionEqualsMonthlyRent %}Commission = 1 mois de loyer{% else %}Commission ${{ activeOffer.commissionSignature }}{% endif %}
                    · {{ activeOffer.retourAnnuel }}% sur achats
                    {% if activeOffer.premierMoisGratuit %} · 1er mois client gratuit{% endif %}
                </span>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin_offers') }}">Gérer les offres</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
    <div class="admin-bridge__grid">
        <a class="admin-bridge__card admin-bridge__card--tzanet" href="{{ path('partner_tzanet') }}" data-reveal data-reveal-delay="40">
            <span class="admin-bridge__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2"/></svg>
            </span>
            <div>
                <strong>Offre TZANET</strong>
                <span>Formulaire partenaire</span>
            </div>
            <em>{{ bridge.tzanet }}</em>
        </a>
    </div>
</section>

<section class="admin-kpi-grid" data-controller="reveal counters">
    <article class="admin-kpi admin-kpi--blue" data-reveal data-reveal-delay="40">
        <div class="admin-kpi__top">
            <span class="admin-kpi__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span class="admin-kpi__tag">Total</span>
        </div>
        <p class="admin-kpi__value"><span data-counters-target="value" data-to="{{ stats.total }}">0</span></p>
        <p class="admin-kpi__label">Leads totaux</p>
        <p class="admin-kpi__hint">Depuis le site client</p>
    </article>

    <article class="admin-kpi admin-kpi--green" data-reveal data-reveal-delay="90">
        <div class="admin-kpi__top">
            <span class="admin-kpi__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2"/></svg>
            </span>
            <span class="admin-kpi__tag">TZANET</span>
        </div>
        <p class="admin-kpi__value"><span data-counters-target="value" data-to="{{ stats.tzanet }}">0</span></p>
        <p class="admin-kpi__label">Via TZANET</p>
        <p class="admin-kpi__hint">Références partenaires</p>
    </article>

    <article class="admin-kpi admin-kpi--violet" data-reveal data-reveal-delay="140">
        <div class="admin-kpi__top">
            <span class="admin-kpi__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            </span>
            <span class="admin-kpi__tag">Contrats</span>
        </div>
        <p class="admin-kpi__value"><span data-counters-target="value" data-to="{{ stats.contracts }}">0</span></p>
        <p class="admin-kpi__label">Contrats</p>
        <p class="admin-kpi__hint">Signatures TZANET</p>
    </article>

    <article class="admin-kpi admin-kpi--money" data-reveal data-reveal-delay="190">
        <div class="admin-kpi__top">
            <span class="admin-kpi__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
            <span class="admin-kpi__tag">Due</span>
        </div>
        <p class="admin-kpi__value admin-kpi__value--money">${{ stats.commissionDue }}</p>
        <p class="admin-kpi__label">Commission due</p>
        <p class="admin-kpi__hint">À payer TZANET</p>
    </article>
</section>

<section class="admin-pipeline" data-controller="reveal counters">
    <article class="admin-pipe" data-reveal data-reveal-delay="40">
        <span class="admin-pipe__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>
        </span>
        <div>
            <strong>Nouveau</strong>
            <span>À traiter</span>
        </div>
        <em><span data-counters-target="value" data-to="{{ stats.new }}">0</span></em>
    </article>
    <article class="admin-pipe" data-reveal data-reveal-delay="90">
        <span class="admin-pipe__icon admin-pipe__icon--blue" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </span>
        <div>
            <strong>Qualifiés</strong>
            <span>En suivi</span>
        </div>
        <em><span data-counters-target="value" data-to="{{ stats.qualified }}">0</span></em>
    </article>
    <article class="admin-pipe" data-reveal data-reveal-delay="140">
        <span class="admin-pipe__icon admin-pipe__icon--green" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16l4-2 4 2 4-2 4 2V8z"/></svg>
        </span>
        <div>
            <strong>Signés</strong>
            <span>{{ stats.contracts }} contrat{{ stats.contracts > 1 ? 's' : '' }}</span>
        </div>
        <em><span data-counters-target="value" data-to="{{ stats.signed }}">0</span></em>
    </article>
    <article class="admin-pipe" data-reveal data-reveal-delay="190">
        <span class="admin-pipe__icon admin-pipe__icon--gold" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
        <div>
            <strong>Payé</strong>
            <span>Commissions</span>
        </div>
        <em>${{ stats.commissionPaid }}</em>
    </article>
</section>

<section class="admin-charts admin-charts--dashboard admin-charts--equal">
    <article class="admin-panel admin-chart-card">
        <div class="admin-panel__head">
            <div>
                <h2>Leads — 6 derniers mois</h2>
                <p>Volume depuis l’offre TZANET</p>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_analytics') }}" class="btn btn-secondary btn-sm">Analytics</a>
            {% endif %}
        </div>
        <div class="admin-panel__body admin-chart-wrap"
             data-controller="chart"
             data-chart-type-value="bar"
             data-chart-label-value="Leads TZANET"
             data-chart-labels-value="{{ charts.leadsMonth.labels|json_encode|e('html_attr') }}"
             data-chart-values-value="{{ charts.leadsMonth.values|json_encode|e('html_attr') }}">
            <canvas height="200"></canvas>
        </div>
    </article>

    <article class="admin-panel admin-chart-card">
        <div class="admin-panel__head">
            <div>
                <h2>Performance TZANET</h2>
                <p>Conversion & commissions</p>
            </div>
        </div>
        <div class="admin-panel__body admin-chart-foot" data-controller="counters">
            <div class="admin-mini-stats">
                <div>
                    <strong><span data-counters-target="value" data-to="{{ stats.conversion }}" data-suffix="%">0</span></strong>
                    <span>Taux conversion</span>
                </div>
                <div>
                    <strong>${{ stats.commissionPaid }}</strong>
                    <span>Commissions payées</span>
                </div>
                <div>
                    <strong>{{ stats.tzanet }}</strong>
                    <span>Leads partenaires</span>
                </div>
            </div>
        </div>
    </article>
</section>

<section class="admin-grid" data-controller="reveal">
    <article class="admin-panel admin-panel--actions" data-reveal data-reveal-delay="60">
        <div class="admin-panel__head">
            <div>
                <h2>Actions liées</h2>
                <p>Admin + site client</p>
            </div>
        </div>
        <div class="admin-panel__body admin-actions">
            <a class="admin-action" href="{{ path('admin_leads') }}">
                <span class="admin-action__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </span>
                <div>
                    <strong>{{ is_granted('ROLE_ADMIN') ? 'Traiter les leads' : 'Voir les leads' }}</strong>
                    <span>Demandes du site public</span>
                </div>
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a class="admin-action" href="{{ path('admin_contracts_new') }}">
                    <span class="admin-action__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                    </span>
                    <div>
                        <strong>Créer un contrat</strong>
                        <span>Commission TZANET auto</span>
                    </div>
                </a>
            {% endif %}
            <a class="admin-action" href="{{ path('partner_tzanet') }}">
                <span class="admin-action__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
                </span>
                <div>
                    <strong>{{ is_granted('ROLE_ADMIN') ? 'Tester un lead TZANET' : 'Voir l’offre TZANET' }}</strong>
                    <span>Formulaire partenaire</span>
                </div>
            </a>
            <a class="admin-action" href="{{ path('partner_tzanet') }}">
                <span class="admin-action__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v12H4z"/><path d="M8 7V5h8v2"/></svg>
                </span>
                <div>
                    <strong>Page partenaire</strong>
                    <span>Offre TZANET publique</span>
                </div>
            </a>
        </div>
    </article>

    <article class="admin-panel" data-reveal data-reveal-delay="120">
        <div class="admin-panel__head">
            <div>
                <h2>Source partenaire</h2>
                <p>Parcours unique TZANET</p>
            </div>
        </div>
        <div class="admin-panel__body">
            {% set total = stats.total > 0 ? stats.total : 1 %}
            {% set tzanetPct = ((stats.tzanet / total) * 100)|round %}
            <div class="source-bars">
                <div class="source-bar">
                    <div class="source-bar__meta">
                        <span class="badge badge--tzanet">TZANET</span>
                        <strong>{{ stats.tzanet }} · {{ stats.total ? tzanetPct : 0 }}%</strong>
                    </div>
                    <div class="source-bar__track">
                        <span class="source-bar__fill source-bar__fill--tzanet" style="--w: {{ stats.total ? tzanetPct : 0 }}%"></span>
                    </div>
                </div>
            </div>
            <p class="admin-footnote">Conversion = (contrats signés + clients actifs) / leads TZANET = {{ stats.conversion }}%</p>
        </div>
    </article>
</section>

<section class="admin-panel" data-controller="reveal">
    <div class="admin-panel__head" data-reveal>
        <div>
            <h2>Dernières demandes TZANET</h2>
            <p>Arrivées depuis l’offre partenaire</p>
        </div>
        <div class="admin-page-head__actions">
            <a href="{{ path('admin_leads_pdf_all') }}" data-turbo="false" class="btn btn-secondary btn-sm">PDF tous les leads</a>
            <a href="{{ path('admin_leads') }}" class="btn btn-secondary btn-sm">Tous les leads</a>
        </div>
    </div>
    <div class="admin-panel__body" data-reveal data-reveal-delay="60">
        {% if latest is empty %}
            <div class="admin-empty">
                <div class="admin-empty__media">
                    <img src="{{ asset('images/restaurant-interior.png') }}" alt="" loading="lazy">
                </div>
                <div class="admin-empty__copy">
                    <h3>Aucune demande pour le moment</h3>
                    <p>Dès qu’un client remplit le formulaire Offre TZANET, le lead apparaît ici.</p>
                    <div class="admin-empty__actions">
                        <a href="{{ path('partner_tzanet') }}" class="btn btn-primary">Tester l’offre TZANET</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Réf.</th>
                            <th>Client</th>
                            <th>Canal</th>
                            <th>Source</th>
                            <th>Statut</th>
                            <th>Machine</th>
                            <th>Créé</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for lead in latest %}
                            <tr>
                                <td><strong>{{ lead.reference }}</strong></td>
                                <td>
                                    <div>{{ lead.nom }}</div>
                                    <div class="text-caption">{{ lead.email }}</div>
                                </td>
                                <td>
                                    <a class="badge badge--canal" href="{{ path(lead.canal.publicRoute) }}">{{ lead.canal.label }}</a>
                                </td>
                                <td>
                                    <span class="badge badge--tzanet">
                                        {{ lead.source.label }}
                                    </span>
                                </td>
                                <td><span class="badge badge--status">{{ lead.status.label }}</span></td>
                                <td>{{ lead.machineRecherchee }}</td>
                                <td>{{ lead.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="admin-table-actions">
                                    <a href="{{ path('admin_leads_show', {id: lead.id}) }}" class="btn btn-secondary btn-sm">Voir</a>
                                    <a href="{{ path('admin_leads_pdf', {id: lead.id}) }}" data-turbo="false" class="btn btn-secondary btn-sm">PDF</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
