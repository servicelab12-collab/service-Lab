{% extends 'admin/base.html.twig' %}

{% block title %}Analytics — ServiceLab Partner Portal{% endblock %}
{% block page_heading %}Analytics{% endblock %}

{% block content %}
<section class="admin-page-head">
    <div>
        <p class="eyebrow">Pilotage</p>
        <h1>Analytics</h1>
        <p>Diagrammes leads TZANET, pipeline et commissions.</p>
    </div>
</section>

<section class="admin-kpi-grid">
    <article class="admin-kpi admin-kpi--blue">
        <p class="admin-kpi__value">{{ stats.leads }}</p>
        <p class="admin-kpi__label">Leads TZANET</p>
    </article>
    <article class="admin-kpi admin-kpi--green">
        <p class="admin-kpi__value">{{ stats.tzanet }}</p>
        <p class="admin-kpi__label">Partenaires</p>
    </article>
    <article class="admin-kpi admin-kpi--violet">
        <p class="admin-kpi__value">{{ stats.contracts }}</p>
        <p class="admin-kpi__label">Contrats</p>
    </article>
    <article class="admin-kpi admin-kpi--money">
        <p class="admin-kpi__value admin-kpi__value--money">${{ stats.commissionDue }}</p>
        <p class="admin-kpi__label">Commission due</p>
    </article>
</section>

<section class="admin-charts">
    <article class="admin-panel admin-chart-card">
        <div class="admin-panel__head">
            <div>
                <h2>Leads par mois</h2>
                <p>Volume TZANET sur 6 mois</p>
            </div>
        </div>
        <div class="admin-panel__body admin-chart-wrap"
             data-controller="chart"
             data-chart-type-value="bar"
             data-chart-label-value="Leads"
             data-chart-labels-value="{{ charts.leadsMonth.labels|json_encode|e('html_attr') }}"
             data-chart-values-value="{{ charts.leadsMonth.values|json_encode|e('html_attr') }}">
            <canvas height="220"></canvas>
        </div>
    </article>

    <article class="admin-panel admin-chart-card">
        <div class="admin-panel__head">
            <div>
                <h2>Pipeline</h2>
                <p>Leads par statut</p>
            </div>
        </div>
        <div class="admin-panel__body admin-chart-wrap"
             data-controller="chart"
             data-chart-type-value="bar"
             data-chart-label-value="Leads"
             data-chart-labels-value="{{ charts.pipeline.labels|json_encode|e('html_attr') }}"
             data-chart-values-value="{{ charts.pipeline.values|json_encode|e('html_attr') }}"
             data-chart-colors-value='["#2F5BFF","#60a5fa","#7c3aed","#f59e0b","#16a34a","#0ea5e9","#94a3b8"]'>
            <canvas height="220"></canvas>
        </div>
    </article>

    <article class="admin-panel admin-chart-card">
        <div class="admin-panel__head">
            <div>
                <h2>Commissions ($)</h2>
                <p>Montants générés / mois</p>
            </div>
        </div>
        <div class="admin-panel__body admin-chart-wrap"
             data-controller="chart"
             data-chart-type-value="line"
             data-chart-label-value="Commissions"
             data-chart-labels-value="{{ charts.commissions.labels|json_encode|e('html_attr') }}"
             data-chart-values-value="{{ charts.commissions.values|json_encode|e('html_attr') }}">
            <canvas height="220"></canvas>
        </div>
    </article>
</section>
{% endblock %}
