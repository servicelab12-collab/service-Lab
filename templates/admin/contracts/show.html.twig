{% extends 'admin/base.html.twig' %}

{% block title %}Contrat #{{ contract.id }}{% endblock %}
{% block page_heading %}Contrat #{{ contract.id }}{% endblock %}

{% block content %}
<section class="admin-page-head">
    <div>
        <p class="eyebrow">Contrat</p>
        <h1>{{ contract.lead.nom }}</h1>
        <p>{{ contract.lead.reference }} · {{ contract.statut.label }}</p>
    </div>
    <div class="admin-page-head__actions">
        <a href="{{ path('admin_contracts') }}" class="btn btn-secondary btn-sm">Retour</a>
        <a href="{{ path('admin_leads_pdf', {id: contract.lead.id}) }}" data-turbo="false" class="btn btn-secondary btn-sm">Télécharger PDF</a>
        <a href="{{ path('admin_leads_show', {id: contract.lead.id}) }}" class="btn btn-primary btn-sm">Voir le lead</a>
        {% if is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('admin_contracts_delete', {id: contract.id}) }}" onsubmit="return confirm('Supprimer ce contrat et sa commission ? Cette action est définitive.');">
                <input type="hidden" name="_token" value="{{ csrf_token('contract_delete_' ~ contract.id) }}">
                <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
            </form>
        {% endif %}
    </div>
</section>

<section class="admin-grid">
    <article class="admin-panel">
        <div class="admin-panel__head"><div><h2>Détails contrat</h2></div></div>
        <div class="admin-panel__body admin-detail-list">
            <div><span>Loyer mensuel</span><strong>${{ contract.loyerMensuel }}</strong></div>
            <div><span>1er mois</span><strong>{{ contract.premierMoisGratuit ? 'Gratuit (code TZANET)' : 'Payant' }}</strong></div>
            <div><span>Durée</span><strong>{{ contract.dureeMois }} mois</strong></div>
            <div><span>Signature</span><strong>{{ contract.dateSignature|date('d/m/Y') }}</strong></div>
            <div><span>Période retour</span><strong>{{ contract.dateSignature|date('d/m/Y') }} → {{ contract.dateSignature|date_modify('+1 year -1 day')|date('d/m/Y') }}</strong></div>
            <div><span>Statut</span><strong>{{ contract.statut.label }}</strong></div>
            <div><span>Source lead</span><strong>{{ contract.lead.source.label }}</strong></div>
        </div>
    </article>
    <article class="admin-panel">
        <div class="admin-panel__head">
            <div>
                <h2>Offre appliquée</h2>
                <p>Conditions commerciales figées à la signature</p>
            </div>
            {% if contract.offer and is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_offers_edit', {id: contract.offer.id}) }}" class="btn btn-secondary btn-sm">Voir l’offre</a>
            {% endif %}
        </div>
        <div class="admin-panel__body">
            {% if contract.offer %}
                {% set offer = contract.offer %}
                <div class="admin-detail-list">
                    <div><span>Offre #</span><strong>#{{ offer.id }}</strong></div>
                    <div><span>1er mois gratuit</span><strong>{{ offer.premierMoisGratuit ? 'Oui' : 'Non' }}</strong></div>
                    <div>
                        <span>Commission</span>
                        <strong>
                            {% if offer.commissionEqualsMonthlyRent %}
                                = 1 mois de loyer
                            {% else %}
                                Fixe ${{ offer.commissionSignature }}
                            {% endif %}
                        </strong>
                    </div>
                    <div><span>Retour annuel</span><strong>{{ offer.retourAnnuel }}%</strong></div>
                    <div>
                        <span>Période offre</span>
                        <strong>
                            {{ offer.dateDebut|date('d/m/Y') }}
                            →
                            {{ offer.dateFin ? offer.dateFin|date('d/m/Y') : '∞' }}
                        </strong>
                    </div>
                    <div><span>Statut offre aujourd’hui</span><strong>{{ offer.active ? 'Toujours référencée' : 'Remplacée / inactive' }}</strong></div>
                </div>
                <p class="text-caption" style="margin-top:12px">
                    Même si l’offre change plus tard, ce contrat garde ces conditions.
                </p>
            {% else %}
                <p class="text-caption">Aucune offre liée (contrat ancien ou hors TZANET).</p>
            {% endif %}
        </div>
    </article>
    <article class="admin-panel">
        <div class="admin-panel__head"><div><h2>Gain TZANET</h2></div></div>
        <div class="admin-panel__body">
            {% if contract.commission %}
                {% set c = contract.commission %}
                <div class="admin-detail-list">
                    <div><span>Commission référencement</span><strong>${{ c.montantSignature }}</strong></div>
                    <div><span>Achats annuels</span><strong>${{ c.achatsAnnuel }}</strong></div>
                    <div><span>Retour {{ c.retourAnnuel }}&nbsp;%</span><strong>${{ c.montantRetour }}</strong></div>
                    <div><span>Total TZANET</span><strong>${{ c.totalTzanet }}</strong></div>
                    <div><span>Statut commission</span><strong>{{ c.statut.label }}</strong></div>
                    <div><span>Paiement</span><strong>{{ c.datePaiement ? c.datePaiement|date('d/m/Y') : '—' }}</strong></div>
                </div>

                {% if app.user.isAdmin %}
                    <form method="post" action="{{ path('admin_commissions_montant', {id: c.id}) }}" class="inline-achat-form" style="margin-top:16px" data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token('commission_montant_' ~ c.id) }}">
                        <input type="hidden" name="_redirect" value="{{ path('admin_contracts_show', {id: contract.id}) }}">
                        <label>
                            <span class="text-caption">Modifier la commission référencement ($)</span>
                            <div class="inline-achat-form__row">
                                <input type="number" name="montant_signature" min="0" step="0.01" value="{{ c.montantSignature }}" required>
                                <button type="submit" class="btn btn-secondary btn-sm">OK</button>
                            </div>
                        </label>
                    </form>

                    <form method="post" action="{{ path('admin_commissions_achats', {id: c.id}) }}" class="inline-achat-form" style="margin-top:12px" data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token('commission_achats_' ~ c.id) }}">
                        <input type="hidden" name="_redirect" value="{{ path('admin_contracts_show', {id: contract.id}) }}">
                        <label>
                            <span class="text-caption">Mettre à jour les achats annuels ($)</span>
                            <div class="inline-achat-form__row">
                                <input type="number" name="achats_annuel" min="0" step="0.01" value="{{ c.achatsAnnuel }}" required>
                                <button type="submit" class="btn btn-primary btn-sm">Calculer retour</button>
                            </div>
                        </label>
                        <p class="text-caption" style="margin-top:8px">Formule : achats × {{ c.retourAnnuel }}&nbsp;% = retour · Total = commission + retour</p>
                    </form>
                {% else %}
                    <p class="text-caption" style="margin-top:12px">Consultation seule — les achats annuels et commissions ne sont pas modifiables.</p>
                {% endif %}
            {% else %}
                <p class="text-caption">Aucune commission (hors partenariat TZANET).</p>
            {% endif %}
        </div>
    </article>
</section>
{% endblock %}
