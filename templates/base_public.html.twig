<!DOCTYPE html>
<html lang="fr" data-controller="page-transition">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ServiceLab Canada{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Location d'équipements de cuisine professionnelle — ServiceLab Canada × TZANET{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="public-body {% block body_class %}{% endblock %}" data-turbo="true">
    <div class="page-transition-overlay" data-page-transition-target="overlay" aria-hidden="true"></div>

    <header class="site-header site-header--pro" data-controller="nav-toggle">
        <div class="site-header__inner">
            <a href="{{ path('app_home') }}" class="site-logo">
                <img
                    class="site-logo__img site-logo__img--white"
                    src="{{ asset('images/brands/servicelab-logo-white.png') }}"
                    alt="ServiceLab Canada"
                    width="180"
                    height="59"
                >
            </a>

            <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle-target="button" data-action="nav-toggle#toggle">
                <span></span><span></span><span></span>
            </button>

            <nav class="site-nav" data-nav-toggle-target="menu" aria-label="Navigation">
                <div class="site-nav__links">
                    <a href="{{ path('app_home') }}" class="site-nav__link {% if pageKey is defined and pageKey == 'home' %}is-active{% endif %}">Accueil</a>
                    <a href="{{ path('app_about') }}" class="site-nav__link {% if pageKey is defined and pageKey == 'about' %}is-active{% endif %}">À propos</a>
                    <a href="{{ path('app_contact') }}" class="site-nav__link {% if pageKey is defined and pageKey == 'contact' %}is-active{% endif %}">Contact</a>
                </div>

                <div class="site-nav__actions">
                    <a href="{{ path('partner_tzanet') }}" class="site-nav__cta {% if pageKey is defined and pageKey == 'partner' %}is-active{% endif %}">
                        Offre TZANET
                    </a>
                    {% if app.user %}
                        <a href="{{ path('admin_dashboard') }}" class="site-nav__profile" title="Espace équipe">
                            <span class="site-nav__avatar" aria-hidden="true">{{ app.user.nom|slice(0,1)|upper }}</span>
                            <span class="site-nav__profile-text">
                                <strong>{{ app.user.nom|split(' ')|first }}</strong>
                                <small>Équipe</small>
                            </span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="site-nav__login">Espace équipe</a>
                    {% endif %}
                </div>
            </nav>
        </div>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer site-footer--pro">
        <div class="footer-top">
            <div class="footer-top__inner">
                <div>
                    <p class="footer-top__eyebrow">ServiceLab Partner Portal</p>
                    <h2 class="footer-top__title">Une cuisine équipée, un parcours clair.</h2>
                </div>
                <div class="footer-top__actions">
                    <a href="{{ path('app_contact') }}" class="btn btn-primary btn-sm">Nous contacter</a>
                    <a href="{{ path('partner_tzanet') }}" class="btn btn-secondary btn-sm footer-top__ghost">Offre TZANET</a>
                </div>
            </div>
        </div>

        <div class="site-footer__grid">
            <div class="footer-brand">
                <a href="{{ path('app_home') }}" class="site-logo site-logo--footer">
                    <img
                        class="site-logo__img site-logo__img--white"
                        src="{{ asset('images/brands/servicelab-logo-white.png') }}"
                        alt="ServiceLab Canada"
                        width="200"
                        height="66"
                    >
                </a>
                <div class="brand-pair" aria-label="Partenaire TZANET">
                    <span class="brand-pair__label">Partenaire</span>
                    <img class="brand-pair__logo brand-pair__logo--tzanet" src="{{ asset('images/brands/tzanet-logo.png') }}" alt="TZANET" width="120" height="33">
                </div>
                <p class="footer-copy">Location d’équipements de cuisine professionnelle, maintenance et partenariat TZANET.</p>
                <div class="footer-badges">
                    <span class="footer-badge"><span class="footer-badge__dot"></span> Portail actif</span>
                    <span class="footer-badge">Montréal, QC</span>
                </div>
            </div>

            <div>
                <p class="footer-title">Produit</p>
                <nav class="footer-links" aria-label="Produit">
                    <a href="{{ path('app_home') }}">
                        <span>Accueil</span>
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 3.3a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4A.75.75 0 0 1 6 11.3L9.3 8 6 4.7a.75.75 0 0 1 0-1.4Z"/></svg>
                    </a>
                    <a href="{{ path('partner_tzanet') }}">
                        <span>Offre TZANET</span>
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 3.3a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4A.75.75 0 0 1 6 11.3L9.3 8 6 4.7a.75.75 0 0 1 0-1.4Z"/></svg>
                    </a>
                    <a href="{{ path('app_about') }}">
                        <span>À propos</span>
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 3.3a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4A.75.75 0 0 1 6 11.3L9.3 8 6 4.7a.75.75 0 0 1 0-1.4Z"/></svg>
                    </a>
                </nav>
            </div>

            <div>
                <p class="footer-title">Support</p>
                <nav class="footer-links" aria-label="Support">
                    <a href="{{ path('app_contact') }}">
                        <span>Contact</span>
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 3.3a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4A.75.75 0 0 1 6 11.3L9.3 8 6 4.7a.75.75 0 0 1 0-1.4Z"/></svg>
                    </a>
                    <a href="mailto:service@servicelabcanada.com">
                        <span>Email</span>
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 3.3a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4A.75.75 0 0 1 6 11.3L9.3 8 6 4.7a.75.75 0 0 1 0-1.4Z"/></svg>
                    </a>
                    <a href="{{ path('app_login') }}">
                        <span>Espace équipe</span>
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6 3.3a.75.75 0 0 1 1.06 0l4 4a.75.75 0 0 1 0 1.06l-4 4A.75.75 0 0 1 6 11.3L9.3 8 6 4.7a.75.75 0 0 1 0-1.4Z"/></svg>
                    </a>
                </nav>
            </div>

            <div>
                <p class="footer-title">Contact</p>
                <div class="footer-contact">
                    <a href="mailto:service@servicelabcanada.com" class="footer-contact__item">
                        <span class="footer-contact__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                        </span>
                        service@servicelabcanada.com
                    </a>
                    <a href="tel:+18772354496" class="footer-contact__item">
                        <span class="footer-contact__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h3l1.5 4.5-2.2 1.4a12 12 0 006.8 6.8l1.4-2.2L21 15v3a2 2 0 01-2 2A14 14 0 014 5a2 2 0 012-2z"/></svg>
                        </span>
                        1-877-235-4496
                    </a>
                    <div class="footer-contact__item footer-contact__item--static">
                        <span class="footer-contact__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.2 7-11a7 7 0 10-14 0c0 5.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        </span>
                        5430 rue Royalmount, Montréal, QC
                    </div>
                </div>
            </div>
        </div>

        <div class="site-footer__bottom">
            <p>© {{ "now"|date('Y') }} ServiceLab Canada. Tous droits réservés.</p>
            <div class="site-footer__meta">
                <span>Partner Portal</span>
                <span class="site-footer__dot" aria-hidden="true"></span>
                <span>Référencement & commissions</span>
            </div>
        </div>
    </footer>
</body>
</html>
