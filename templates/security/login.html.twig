{% extends 'base.html.twig' %}

{% block title %}Connexion admin — ServiceLab Partner Portal{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-layout" data-controller="auth-bg reveal">
    <aside class="auth-showcase">
        <div class="auth-bg" aria-hidden="true">
            <span class="auth-orb auth-orb--1" data-auth-bg-target="orb"></span>
            <span class="auth-orb auth-orb--2" data-auth-bg-target="orb"></span>
            <span class="auth-orb auth-orb--3" data-auth-bg-target="orb"></span>
            <span class="auth-grid"></span>
            <canvas class="auth-particles" data-auth-bg-target="canvas" width="800" height="900"></canvas>
        </div>

        <div class="auth-showcase__content" data-reveal>
            <div class="auth-brand">
                <span class="auth-brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
                        <rect width="32" height="32" rx="8" fill="#fff"/>
                        <path d="M8 21V11h5.2c2.4 0 3.9 1.3 3.9 3.2 0 1.3-.7 2.3-1.9 2.8L18.8 21h-2.7l-3.3-3.7H10.4V21H8Zm2.4-5.5h2.5c1.2 0 1.9-.6 1.9-1.5s-.7-1.4-1.9-1.4H10.4v2.9Z" fill="#0F141C"/>
                    </svg>
                </span>
                <div>
                    <strong>ServiceLab</strong>
                    <small>Canada</small>
                </div>
            </div>

            <p class="eyebrow eyebrow--glow">Partner Portal</p>
            <h1>Espace équipe<br>ServiceLab</h1>
            <p class="auth-showcase__lead">Suivez les leads TZANET, les contrats et les commissions partenaires.</p>

            <ul class="auth-points">
                <li data-reveal data-reveal-delay="80">
                    <span class="auth-point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Source auto</strong>
                        <span>Identification TZANET</span>
                    </div>
                </li>
                <li data-reveal data-reveal-delay="140">
                    <span class="auth-point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M4 6h16M4 12h10M4 18h7"/><circle cx="18" cy="16" r="3"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Pipeline clair</strong>
                        <span>Du lead au contrat signé</span>
                    </div>
                </li>
                <li data-reveal data-reveal-delay="200">
                    <span class="auth-point-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 3v18M7 8h7a3 3 0 0 1 0 6H9"/><path d="M9 14h5a3 3 0 0 1 0 6H7"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Commissions</strong>
                        <span>Calcul automatique à la signature</span>
                    </div>
                </li>
            </ul>
        </div>
    </aside>

    <div class="auth-shell">
        <div class="auth-shell__glow" aria-hidden="true"></div>
        <div class="auth-card auth-card--pro" data-reveal="scale" data-reveal-delay="80">
            <a href="{{ path('app_home') }}" class="auth-back">
                <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12.7 4.3a1 1 0 0 1 0 1.4L8.4 10l4.3 4.3a1 1 0 1 1-1.4 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.4 0Z"/></svg>
                Retour au site
            </a>

            <div class="auth-card__header">
                <span class="auth-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="5" y="11" width="14" height="10" rx="2"/>
                        <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                    </svg>
                </span>
                <div>
                    <h2>Connexion</h2>
                    <p class="auth-subtitle">Réservé aux administrateurs et commerciaux.</p>
                </div>
            </div>

            {% if error %}
                <div class="alert alert-error auth-alert" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="alert alert-success auth-alert" role="status">{{ message }}</div>
            {% endfor %}

            <form method="post" class="auth-form" data-controller="lead-form" data-action="submit->lead-form#submit" novalidate>
                <div class="form-field">
                    <label for="email">Adresse e-mail</label>
                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="5" width="18" height="14" rx="2"/>
                                <path d="m4 7 8 6 8-6"/>
                            </svg>
                        </span>
                        <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus autocomplete="username" placeholder="admin@servicelab.ca">
                    </div>
                </div>

                <div class="form-field">
                    <label for="password">Mot de passe</label>
                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="5" y="11" width="14" height="10" rx="2"/>
                                <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                            </svg>
                        </span>
                        <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
                    </div>
                </div>

                <div class="form-row">
                    <label class="checkbox">
                        <input type="checkbox" name="_remember_me">
                        Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}" class="link-muted">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" autocomplete="off">

                <button type="submit" class="btn btn-primary btn-block btn-lg auth-submit" data-lead-form-target="button">
                    <span data-lead-form-target="label">Se connecter</span>
                    <svg class="auth-submit__arrow" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                        <path d="M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 1 1-1.4-1.4L11.6 10 7.3 5.7a1 1 0 0 1 0-1.4Z"/>
                    </svg>
                    <span class="btn-spinner" data-lead-form-target="spinner" hidden aria-hidden="true"></span>
                </button>
            </form>

            <p class="auth-footnote">Connexion sécurisée · ServiceLab Partner Portal</p>
        </div>
    </div>
</div>
{% endblock %}
